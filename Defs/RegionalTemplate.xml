<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Regional map template hydration (slice 2). The template generator
       deliberately does NOT inherit MapCommonBase: geography comes from
       the armed artifact, and only the run-state steps execute natively
       afterward. Armed exclusively via CA_REGIONAL_TEMPLATE; without a
       validated artifact this def is never selected. -->

  <GenStepDef>
    <defName>CA_TemplateHydration</defName>
    <order>10</order>
    <genStep Class="ColonistAwareness.GenStep_CARegionalTemplateHydration"/>
  </GenStepDef>

  <MapGeneratorDef>
    <defName>CA_RegionalTemplate</defName>
    <genSteps>
      <li>CA_TemplateHydration</li>
      <li>FindPlayerStartSpot</li>
      <li>ScenParts</li>
      <li>Fog</li>
    </genSteps>
  </MapGeneratorDef>

</Defs>
