<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <HediffDef>
    <defName>CA_Dragging</defName>
    <label>dragging</label>
    <description>Hauling a body low and fast - a pull, not a carry.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>2500~2500</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <statFactors>
          <MoveSpeed>1.25</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>CA_MovingFire</defName>
    <label>firing on the move</label>
    <description>Shooting while walking. The barrel never settles - accuracy suffers, less so for practiced shooters.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.7,0.8,0.9)</defaultLabelColor>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <!-- Self-expiring: the driver rewinds this every pulse while the pawn is
           actually firing on the move; an orphaned instance (save/load, off-map)
           dies on its own instead of becoming a permanent accuracy debuff. -->
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>240</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <label>practiced</label>
        <statOffsets>
          <ShootingAccuracyPawn>-2</ShootingAccuracyPawn>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>unsteady</label>
        <statOffsets>
          <ShootingAccuracyPawn>-4</ShootingAccuracyPawn>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.7</minSeverity>
        <label>wild</label>
        <statOffsets>
          <ShootingAccuracyPawn>-7</ShootingAccuracyPawn>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>CA_FirstStrike</defName>
    <label>first strike</label>
    <description>The opening seconds of a surprise attack: the target never saw it coming. Strikes land harder and truer until the advantage fades.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9,0.75,0.4)</defaultLabelColor>
    <initialSeverity>0.2</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>480~480</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
    <stages>
      <li>
        <label>opening</label>
        <statOffsets>
          <MeleeHitChance>2</MeleeHitChance>
          <ShootingAccuracyPawn>2</ShootingAccuracyPawn>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.25</MeleeDamageFactor>
        </statFactors>
        <capMods>
          <li><capacity>Moving</capacity><offset>0.10</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.4</minSeverity>
        <label>clean opening</label>
        <statOffsets>
          <MeleeHitChance>3</MeleeHitChance>
          <ShootingAccuracyPawn>4</ShootingAccuracyPawn>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.4</MeleeDamageFactor>
        </statFactors>
        <capMods>
          <li><capacity>Moving</capacity><offset>0.18</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>perfect opening</label>
        <statOffsets>
          <MeleeHitChance>4</MeleeHitChance>
          <ShootingAccuracyPawn>6</ShootingAccuracyPawn>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>1.6</MeleeDamageFactor>
        </statFactors>
        <capMods>
          <li><capacity>Moving</capacity><offset>0.28</offset></li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>CA_BodyWeight</defName>
    <label>body weight</label>
    <description>Long-run caloric balance. Consistent overeating adds weight; sustained hunger strips it. Both ends cost speed and carrying strength; the middle is fitness.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.85,0.85,0.6)</defaultLabelColor>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <minSeverity>0</minSeverity>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>emaciated</label>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.30</offset></li>
        </capMods>
        <statOffsets>
          <CarryingCapacity>-25</CarryingCapacity>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.15</minSeverity>
        <label>underweight</label>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.10</offset></li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.35</minSeverity>
        <label>fit</label>
      </li>
      <li>
        <minSeverity>0.65</minSeverity>
        <label>overweight</label>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.10</offset></li>
        </capMods>
        <hungerRateFactor>1.1</hungerRateFactor>
      </li>
      <li>
        <minSeverity>0.85</minSeverity>
        <label>obese</label>
        <capMods>
          <li><capacity>Moving</capacity><offset>-0.25</offset></li>
        </capMods>
        <statOffsets>
          <CarryingCapacity>-15</CarryingCapacity>
        </statOffsets>
        <hungerRateFactor>1.2</hungerRateFactor>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>CA_AssistedCarry</defName>
    <label>buddy carry</label>
    <description>An able ally is helping move this casualty. Two sets of hands move a body far faster than one.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6,0.85,1.0)</defaultLabelColor>
    <initialSeverity>0.5</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <minSeverity>0</minSeverity>
        <label>assisted</label>
        <statFactors>
          <MoveSpeed>1.25</MoveSpeed>
        </statFactors>
      </li>
      <li>
        <minSeverity>0.75</minSeverity>
        <label>full buddy carry</label>
        <statFactors>
          <MoveSpeed>1.5</MoveSpeed>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
