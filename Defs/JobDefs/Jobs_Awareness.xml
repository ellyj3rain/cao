<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <JobDef>
    <defName>CA_StackPosture</defName>
    <driverClass>ColonistAwareness.JobDriver_CAStackPosture</driverClass>
    <reportString>holding position.</reportString>
    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>

  <JobDef>
    <defName>CA_CombatPosture</defName>
    <driverClass>ColonistAwareness.JobDriver_CACombatPosture</driverClass>
    <reportString>assessing a known contact.</reportString>
    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>

  <JobDef>
    <defName>CA_CombatMove</defName>
    <driverClass>ColonistAwareness.JobDriver_CACombatMove</driverClass>
