    <alwaysShowWeapon>true</alwaysShowWeapon>
  </JobDef>

  <JobDef>
    <defName>CA_FightingWithdrawal</defName>
    <driverClass>ColonistAwareness.JobDriver_CAWithdrawal</driverClass>
    <reportString>executing a fighting withdrawal.</reportString>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <suspendable>false</suspendable>
    <checkOverrideOnDamage>Never</checkOverrideOnDamage>
  </JobDef>

  <JobDef>
    <defName>CA_Shelter</defName>
    <driverClass>ColonistAwareness.JobDriver_CAShelter</driverClass>
    <reportString>sheltering from an active raid or known threat.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <suspendable>false</suspendable>
  </JobDef>

  <JobDef>
    <defName>CA_CombatRecovery</defName>
    <driverClass>ColonistAwareness.JobDriver_CACombatRecovery</driverClass>
