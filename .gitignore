# build intermediates (the shipped DLL in Assemblies/ IS tracked)
Source/obj/
Source/bin/
/obj/
tools/**/obj/
tools/**/bin/
*.user

# twin-build outputs (reproducible from source; ~559 MB across ~275 directories)
.build-*/

# upstream mod source kept locally for reference only; never a build input.
# provenance is recorded in CREDITS.md and UPSTREAM_SOURCES.md instead.
.vendor/

# third-party binaries; not build inputs (the csproj resolves refs from NuGet)
.vf-assemblies-staging/

# never commit decompiled game source (lives outside the repo; keep it that way)
rimworld-decompiled/

# Machine-learning corpus payload is local by default. This includes source
# saves/snapshots, normalized per-layout records, screening/cohort manifests,
# caches, and train/validation/test working sets. Only the directory boundary
# and a non-reconstructive aggregate profile are publishable exceptions.
Corpus/PlayerBaseLayouts/**
!Corpus/PlayerBaseLayouts/
!Corpus/PlayerBaseLayouts/README.md
!Corpus/PlayerBaseLayouts/external/
Corpus/PlayerBaseLayouts/external/**
!Corpus/PlayerBaseLayouts/external/real-ruins-broad-profile.json

# B18 performance evidence storage boundary (see Receipts/B18/B18_PERFORMANCE_ARTIFACT_INDEX.md)
Receipts/B18/Performance/**/*.log
Receipts/B18/Performance/diagnostic-200x4-access-diagnostic-run1/*.png


# convergence-exercise scratch (build outputs, not canonical)
/.tmp/


# B18 performance evidence storage boundary (see Receipts/B18/B18_PERFORMANCE_ARTIFACT_INDEX.md)
Receipts/B18/**/*.log
Receipts/B18/**/ca-passive-progress.txt
Receipts/B18/Performance/diagnostic-200x4-access-diagnostic-run1/*.png
/.tmp/
