<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- RimWorld exposes no insertTag in HumanlikeConstant. Operational equipment
       gets its existing first chance. Incident-bounded casualty triage then yields
       to recent harm, known or visible active danger; the shared combat giver owns
       that danger and follows before vanilla's civilian hostility response. -->
  <Operation Class="PatchOperationInsert">
    <xpath>Defs/ThinkTreeDef[defName="HumanlikeConstant"]/thinkRoot/subNodes/li[@Class="ThinkNode_ConditionalCanDoConstantThinkTreeJobNow"]/subNodes/li[@Class="JobGiver_ConfigurableHostilityResponse"]</xpath>
    <value>
      <li Class="ColonistAwareness.JobGiver_CAOperationalEquipment" />
      <li Class="ColonistAwareness.JobGiver_CAMissionTriage" />
      <li Class="ColonistAwareness.JobGiver_CACombatReaction" />
      <li Class="ColonistAwareness.JobGiver_CAWelfareResponse" />
      <li Class="ColonistAwareness.JobGiver_CACombatAftermath" />
    </value>
  </Operation>
</Patch>
